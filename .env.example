GITHUB_TOKEN=
# Use exact owner/repository entries or owner/*; writes require a non-empty allowlist.
ALLOWED_GITHUB_REPOS=
# A separate fine-grained token for write tools, restricted to allowed repos.
GITHUB_WRITE_TOKEN=
GITHUB_API_BASE_URL=https://api.github.com
ALLOWED_DOCKER_CONTAINERS=
MAX_LOG_LINES=200
MAX_OUTPUT_CHARS=8000
GITHUB_WRITE_BRANCH_PREFIX=ai/
BLOCKED_GITHUB_PATHS=.github/workflows/
# Keep disabled unless you explicitly need the confirmation-gated write tools.
ENABLE_WRITE_TOOLS=false
